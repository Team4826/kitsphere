# Backend environment example for KitSphere
# Copy to .env and fill values before running in production

# JWT secret used for signing tokens
JWT_SECRET=your_jwt_secret_here

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/kitsphere

# SMTP (optional) - if configured, password reset emails will be sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret
EMAIL_FROM="KitSphere <no-reply@example.com>"

# Frontend reset base: when sending reset links, the backend will append
# ?token=...&email=... to this base. For Expo dev, set to your expo dev URL:
# Example (Expo dev client): exp://192.168.1.5:19000/--/reset-password
# Example (app scheme): mobile://reset-password
FRONTEND_RESET_BASE=exp://<your-local-ip>:19000/--/reset-password

# Google Client ID (optional): used to validate idTokens from the client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: NODE_ENV=development|production
NODE_ENV=development
